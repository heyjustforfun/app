# Copy to backend/.env for local development.
# On Hostinger, set these in hPanel → Websites → your Node.js app → Environment variables instead.

NODE_ENV=production
PORT=4100

# MySQL (Hostinger: hPanel → Databases → MySQL Databases). From the app always use 127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u123456789_fund
DB_PASSWORD=change-me
DB_NAME=u123456789_fund

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First administrator account, created automatically on the first start.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Where receipts, ID documents and reports are stored. Use a folder OUTSIDE the
# deployed app so redeploys don't delete it, e.g. /home/u123456789/fund-uploads
UPLOAD_DIR=
